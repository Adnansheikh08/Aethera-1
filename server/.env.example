# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/aethera

# ── Secrets ────────────────────────────────────────────────────────────────
# Must equal the Django SECRET_KEY. It peppers the legacy email hashes, so
# changing it after the migration would break data-erasure lookups.
SECRET_KEY=change-me

# Base64 32-byte AES-256-GCM key(s), comma-separated. First key encrypts, all
# keys are tried on decrypt (MultiFernet rotation semantics). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# The old Django Fernet key. Needed only to run scripts/importLegacy.js once;
# safe to delete from .env after the migration completes.
LEGACY_FERNET_KEY=

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# jsonwebtoken expiry strings
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Payments ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────
# Obfuscated admin path, ported from Django. Change once in production and
# keep it out of your public docs.
ADMIN_URL_PATH=portal-admin-8f2e9a7c
