# Frontend Environment Variables
# Copy this file to .env and update the values

# Admin panel API path (matches server config.adminUrlPath)
# This is an obscured path, not a real secret. The real authentication is JWT + TOTP.
# Keep this in sync with ADMIN_URL_PATH in the root .env
VITE_ADMIN_API_PATH=portal-admin-8f2e9a7c

# API Base URL (backend server endpoint)
# Default: http://localhost:5000 (development)
# VITE_API_URL=http://localhost:5000
